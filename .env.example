# Use a long random value in production.
DATABASE_URL=postgres://username:password@host:5432/database?sslmode=require
# For Aiven, paste the project CA certificate as one value. Literal \n sequences are converted to newlines.
DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Local-only fallback when no CA certificate is configured. Prefer DATABASE_CA_CERT.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
